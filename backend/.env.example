# Copy to backend/.env and fill in real values. Never commit backend/.env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=cakupan
POSTGRES_USER=cakupan
POSTGRES_PASSWORD=cakupan
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
BPS_RESPONSE_CACHE_TTL_SECONDS=3600

# BPS WebAPI — get your own key at https://webapi.bps.go.id/
# Never commit this value; it is masked in logs/UI, never logged in plaintext.
BPS_API_KEY=
BPS_API_BASE_URL=https://webapi.bps.go.id/v1/api
BPS_RATE_LIMIT_INTERVAL_SECONDS=0.75
BPS_MAX_RETRIES=5
BPS_MAX_CONSECUTIVE_FAILURES=10

# Sampling (CLAUDE.md rule 4 — must stay explicit and documented, not silent)
COVERAGE_SAMPLE_PROVINCE_COUNT=5
COVERAGE_SAMPLE_KABUPATEN_PER_PROVINCE=3

# SIMDASI (separate system, PRD §5.4) — validate against real docs before Phase 5
SIMDASI_API_BASE_URL=https://simdasi.bps.go.id/v1/api
SIMDASI_SAMPLE_MFD_CODES=

CORS_ALLOWED_ORIGINS=http://localhost:3000
